#!/usr/bin/env node
// publish-resume — project resume-backlog onto resume-public.
//
// The two databases were split once (db/0001_seed_public_resume.sql) and then
// diverged, silently, because nothing connected them: the private resume Worker
// binds only resume-backlog and has never heard of resume-public. Every bullet
// written since the split went somewhere the website cannot read. This script
// is the missing link, and it is deliberately not automatic — publishing is a
// disclosure decision, so a human runs it and reads the diff first.
//
//   bin/publish-resume            # print the SQL, change nothing
//   bin/publish-resume --out FILE # write the SQL to a file
//   bin/publish-resume --apply    # execute it against resume-public
//
// Requires wrangler to be authenticated (CLOUDFLARE_API_TOKEN or `wrangler
// login`). Reads with --remote; both databases live in the same account.
//
// ── What is NOT published, and why ────────────────────────────────────────────
//
// 1. accomplishments.notes — working commentary, never résumé copy. It holds
//    internal reasoning ("Leadership was split on necessity"), vendor
//    comparisons and job-search thinking. Nothing renders it and nothing
//    should; the public database has no business holding it.
//
// 2. roles.note — the same column means different things on each side. In
//    resume-backlog it is a working note ("Open: verify whether Staff Architect
//    title was formally retained (check promotion letters)"); in resume-public
//    it is a rendered parenthetical ("official title: Staff Architect 2"). It
//    IS displayed on the résumé, so copying the backlog's version would print
//    working notes on a public page. Public notes are curated by hand and this
//    script preserves them rather than overwriting.
//
// 3. Bullets tagged `private` — the escape hatch for material that is true and
//    good and still nobody else's business. Tag a bullet `private` in the
//    backlog and it stays there.
//
// 4. Targets not named in PUBLIC_TARGETS — a target is a job-application
//    filter. `tremendous` names a company being applied to; publishing it would
//    disclose the job search on the public site.
//
// 5. The job-pipeline tables (jobs, job_events, job_interviews, job_notes,
//    job_emails, target_companies, agent_contract, projects) — the reason the
//    split exists at all. They are not enumerated below; only the five tables
//    named in TABLES are ever read.

import { execFileSync } from "node:child_process";
import { writeFileSync } from "node:fs";

const BACKLOG = "resume-backlog";
const PUBLIC = "resume-public";

/** Targets the public site is allowed to serve. Everything else stays private. */
const PUBLIC_TARGETS = ["website", "principal-security", "staff-architect"];

/** A bullet carrying this tag is never published. */
const PRIVATE_TAG = "private";

const TABLES = ["profile", "companies", "roles", "accomplishments", "targets"];

function usage() {
  console.error(`usage: bin/publish-resume [--apply] [--out FILE]

  (no flags)   print the SQL to stdout and change nothing
  --out FILE   write the SQL to FILE
  --apply      execute the SQL against ${PUBLIC}

Read the SQL before you apply it. It replaces the contents of
${TABLES.join(", ")} in ${PUBLIC}.`);
}

/** Run a read-only query and return its rows. */
function query(db, sql) {
  let raw;
  try {
    raw = execFileSync(
      "npx",
      ["wrangler", "d1", "execute", db, "--remote", "--json", "--command", sql],
      { encoding: "utf8", maxBuffer: 64 * 1024 * 1024 },
    );
  } catch (err) {
    const detail = err.stdout || err.stderr || err.message;
    throw new Error(`reading ${db} failed:\n${detail}`);
  }
  // wrangler prints warnings before the JSON; the payload starts at the first
  // bracket or brace on its own.
  const start = raw.search(/[[{]/);
  if (start === -1) throw new Error(`no JSON in wrangler output for ${db}:\n${raw}`);
  const parsed = JSON.parse(raw.slice(start));
  if (parsed?.error) throw new Error(`${db}: ${parsed.error.text ?? JSON.stringify(parsed.error)}`);
  const first = Array.isArray(parsed) ? parsed[0] : parsed;
  return first?.results ?? [];
}

/**
 * Build the INSERT statements for one table, letting SQLite do the quoting.
 *
 * quote() is the database's own literal escaper — it handles embedded
 * apostrophes and NULL correctly, which hand-rolled string building does not.
 * Every bullet on this résumé is prose, and prose has apostrophes in it.
 */
function statementsFor(table, columns, where = "", order = "") {
  const cols = columns.join(",");
  const values = columns.map((c) => `quote("${c}")`).join(` || ',' || `);
  const sql =
    `SELECT 'INSERT INTO ${table} (${cols}) VALUES (' || ${values} || ');' AS stmt ` +
    `FROM ${table} ${where} ${order}`.trimEnd();
  return query(BACKLOG, sql).map((r) => r.stmt);
}

function main() {
  const args = process.argv.slice(2);
  if (args.includes("--help") || args.includes("-h")) {
    usage();
    process.exit(0);
  }
  const apply = args.includes("--apply");
  const outAt = args.indexOf("--out");
  const outFile = outAt === -1 ? null : args[outAt + 1];
  if (outAt !== -1 && !outFile) {
    usage();
    process.exit(2);
  }

  const notPrivate =
    `WHERE (tags IS NULL OR ', ' || tags || ', ' NOT LIKE '%, ${PRIVATE_TAG}, %')`;
  const targetList = PUBLIC_TARGETS.map((t) => `'${t}'`).join(", ");

  const parts = [
    statementsFor("profile", ["section", "key", "value"]),
    statementsFor("companies", ["key", "display", "location", "sort_order"], "", "ORDER BY sort_order"),
    // note is omitted on purpose — see (2) in the header.
    statementsFor("roles", ["id", "company_key", "title", "start", "end", "sort_order"], "", "ORDER BY sort_order"),
    // notes is omitted on purpose — see (1).
    statementsFor(
      "accomplishments",
      ["id", "role_id", "bullet", "tags", "metric", "date_added"],
      notPrivate,
      "ORDER BY id",
    ),
    statementsFor(
      "targets",
      ["name", "headline", "summary", "include_tags", "boost_tags", "exclude_tags", "max_bullets_per_role", "num_highlights"],
      `WHERE name IN (${targetList})`,
      "ORDER BY name",
    ),
  ];

  const counts = TABLES.map((t, i) => `${t}: ${parts[i].length}`).join(", ");

  const sql = [
    `-- Generated by bin/publish-resume on ${new Date().toISOString()}`,
    `-- ${BACKLOG} -> ${PUBLIC}. ${counts}`,
    `-- Excluded: accomplishments.notes, roles.note, bullets tagged '${PRIVATE_TAG}',`,
    `-- and every target except ${PUBLIC_TARGETS.join(", ")}.`,
    "",
    "-- roles.note is curated on the public side and must survive the replace.",
    "CREATE TEMP TABLE kept_notes AS SELECT id, note FROM roles WHERE note IS NOT NULL;",
    "",
    ...TABLES.map((t) => `DELETE FROM ${t};`),
    "",
    ...parts.flatMap((stmts, i) => [`-- ${TABLES[i]}`, ...stmts, ""]),
    "UPDATE roles SET note = (SELECT note FROM kept_notes WHERE kept_notes.id = roles.id)",
    "  WHERE id IN (SELECT id FROM kept_notes);",
    "DROP TABLE kept_notes;",
    "",
  ].join("\n");

  if (outFile) {
    writeFileSync(outFile, sql);
    console.error(`wrote ${outFile} (${counts})`);
  }
  if (!apply && !outFile) process.stdout.write(sql);

  if (apply) {
    const file = outFile ?? `/tmp/publish-resume-${Date.now()}.sql`;
    if (!outFile) writeFileSync(file, sql);
    console.error(`applying to ${PUBLIC} (${counts})`);
    execFileSync("npx", ["wrangler", "d1", "execute", PUBLIC, "--remote", "--file", file], {
      stdio: "inherit",
    });
    console.error("done");
  }
}

main();
